{
    "extends": [
        "eslint:recommended"
    ],
    "plugins": [],
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
    },
    "env": {
        "browser": true,
        "es6": true
    },
    "globals": {},
    "rules": {
        "no-unused-vars": 0,
        "no-undef": 0,
        "no-octal": "error",
        "no-octal-escape": "error",
        "no-with": "error",
        "no-delete-var": "error"
    }
}